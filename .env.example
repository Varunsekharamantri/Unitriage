VISION_PROVIDERS=gemini,groq
GEMINI_API_KEY=your-free-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your-free-groq-key
GROQ_MODEL=qwen/qwen3.8-27b
UNSPLASH_ACCESS_KEY=only-needed-for-evals-fetch-photos
CHECKPOINT_DB_PATH=checkpoints.sqlite
CONFIDENCE_THRESHOLD=0.75
VISION_RETRIES_PER_PROVIDER=2
VAULT_SECRET=change-me

# Optional last-resort fallback, tried after Gemini and Groq. Model must accept images.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Owner approval card: llm (AI-written summary, template on failure) or off
SUMMARY_MODE=llm

# Postgres, e.g. Neon (use the direct, non-pooled string). Empty = SQLite + memory.
DATABASE_URL=

# Voice calls: Sarvam speech-to-text and text-to-speech (Indian English). Empty = browser speech.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=priya
SARVAM_STT_LANGUAGE=en-IN

# Guardrails for a public demo
RATE_LIMIT_ENABLED=true
SARVAM_DAILY_LIMIT=400
CALL_MAX_SECONDS=600
CALL_IDLE_SECONDS=20
